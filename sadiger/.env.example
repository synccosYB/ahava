# --- Required ---
# PostgreSQL connection (Replit sets this automatically when you add a database)
DATABASE_URL=postgres://user:password@host:5432/sadiger
# Long random string; keeps logins secure. Generate one, e.g.: openssl rand -hex 32
SESSION_SECRET=
# First login, created automatically the first time the app starts with an empty database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=production

# --- Email (receipts and the monthly report to Israel) ---
# Google Workspace example: smtp.gmail.com / 587 / your address / an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sadiger Institution in Israel <receipts@givetosadiger.org>"

# --- Optional ---
# Lets an outside scheduler trigger the monthly report: GET /cron/monthly?key=THIS_VALUE
CRON_SECRET=
# Time zone used for "today" (default America/New_York)
TZ_DISPLAY=America/New_York
# PGSSL=true   # if your database requires SSL and the URL doesn't say sslmode=require
